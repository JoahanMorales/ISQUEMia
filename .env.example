# ISQUEMIA — todas las llaves son opcionales.
# Sin ninguna, el sistema corre completo con adaptadores locales deterministas.
# Con una, el slot correspondiente cambia a remoto y el panel lo muestra.

# Negociación y voz (Realtime, K=6 carriles)
OPENAI_API_KEY=

# Workspace: expediente AOOS, escalamiento, canal de operación
AMBIGUOUS_API_KEY=
AMBIGUOUS_BASE_URL=https://app.ambiguous.ai/api

# Búsqueda citada de criterios OPTN y de centros
EXA_API_KEY=

# Identidad por agente para el registro de auditoría
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Ejecución durable de carriles (concurrencia 40 / 4)
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# Opcional: si aparece, el router de modelos lo prefiere
OPENROUTER_API_KEY=
